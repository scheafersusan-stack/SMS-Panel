# Edge for the Payamakyar panel (dev stack and the shape of production).
#   - static web (Next export) from /srv with SPA fallback to index.html
#   - /panel/* is proxied to the API; Caddy sets X-Forwarded-For, the API trusts it only because
#     PAYAMAKYAR_TRUSTED_PROXIES covers the compose network (uvicorn proxy_headers stays off)
#   - security headers; the CSP is generated at web build time (see below)
#
# Site address: PAYAMAKYAR_SITE (default localhost -> Caddy's internal CA; use a real domain in
# production and Caddy obtains a certificate automatically).
{$PAYAMAKYAR_SITE:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Fail-closed default CSP: scripts only from our own origin. The import below REPLACES it with
	# the full policy generated by `npm run build` (apps/panel-web/scripts/csp-hashes.mjs): the
	# same policy plus sha256 sources for the inline scripts the Next static export emits. The
	# pre-paint theme script is a static file (/theme-init.js), so it needs no hash.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	import /etc/caddy/csp/*.caddy

	handle /panel/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv
		try_files {path} {path}/ /index.html
		file_server
	}
}
