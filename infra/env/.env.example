# Copy to infra/.env (compose reads it automatically): cp infra/env/.env.example infra/.env
# Required: compose refuses to start without POSTGRES_PASSWORD and PAYAMAKYAR_SECRET_KEY.
# The values below are DEV ONLY. With PAYAMAKYAR_ENV=prod the API refuses the dev secret key and
# the dev database password, so set real ones (and PAYAMAKYAR_ENV=prod) for production.

PAYAMAKYAR_ENV=dev
PAYAMAKYAR_LOG_LEVEL=INFO

# Postgres (the compose postgres service creates this role/database on first start)
POSTGRES_USER=payamakyar
POSTGRES_PASSWORD=payamakyar
POSTGRES_DB=payamakyar

# Fernet key sealing TOTP secrets and MFA tokens. Required in prod. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYAMAKYAR_SECRET_KEY=ZGV2LW9ubHktcGF5YW1ha3lhci1rZXktMDAwMDAwMDA=

# Public address users type (Caddy site, links, cookie scope). Host ports must match the URL.
PAYAMAKYAR_SITE=localhost
PAYAMAKYAR_PUBLIC_BASE_URL=https://localhost:8443
PAYAMAKYAR_HTTPS_PORT=8443
PAYAMAKYAR_HTTP_PORT=8080

# Client-IP trust. uvicorn runs with proxy_headers=False, so X-Forwarded-For is honoured ONLY
# for peers inside this comma-separated CIDR list. It must cover the compose network (the
# `edge` network is 172.28.0.0/24 in docker-compose.yml) and nothing wider: otherwise any client
# could spoof its IP and defeat IP allow-lists and login rate limits. Keep in sync with compose.
PAYAMAKYAR_TRUSTED_PROXIES=172.28.0.0/24

# Worker poll interval in seconds
PAYAMAKYAR_WORKER_POLL_SECONDS=1.0
